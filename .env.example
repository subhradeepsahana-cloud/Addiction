# ─────────────────────────────────────────────────────────────────────────
# Sober Companion — environment configuration
#
# Copy this file to `.env` and fill in real values for local development.
# Copy it to `.env.staging` / `.env.production` for other environments.
# NEVER commit a real `.env` file. See docs/DEPLOYMENT.md for full setup.
# ─────────────────────────────────────────────────────────────────────────

# ── App branding (client, safe to expose) ─────────────────────────────────
# Rebrand the app without touching source code.
EXPO_PUBLIC_APP_NAME="Sober Companion"

# ── Supabase (client, safe to expose — protected by Row Level Security) ───
# Found in Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Client feature flags ───────────────────────────────────────────────────
# Set to "true" once Supabase + OpenAI are configured. When "false" the app
# runs in local mock mode: onboarding, logging, craving mode, and streaks
# all work against on-device storage so the app is fully demoable without
# any backend credentials.
EXPO_PUBLIC_BACKEND_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────
# The variables below are SERVER-SIDE ONLY. They are consumed by Supabase
# Edge Functions (supabase/functions/*), never by the mobile app, and must
# be set with `supabase secrets set` — do not prefix them with EXPO_PUBLIC_
# or they would be bundled into the client.
# ─────────────────────────────────────────────────────────────────────────

# OpenAI API key used server-side by Edge Functions for AI Coach, drink
# extraction, insight generation, safety classification, and the
# scientific-knowledge assistant. Get one at https://platform.openai.com.
OPENAI_API_KEY=sk-your-openai-key

# Model IDs, overridable without a redeploy. Pick current, cost-appropriate
# OpenAI models; these are sensible defaults at implementation time.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# Service role key for Edge Functions that need elevated DB access
# (e.g. writing safety_events, running scheduled insight jobs). Treat as a
# root credential — Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Country-specific emergency resources shown in the Safety screen fall back
# to this ISO 3166-1 alpha-2 country code when the user hasn't set one.
DEFAULT_EMERGENCY_COUNTRY=US
